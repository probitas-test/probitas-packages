{
  "name": "probitas-packages",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "internal/*"
  ],
  "scripts": {
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "biome lint .",
    "check": "tsc -p .",
    "test": "bun test --timeout 60000 ./internal ./packages",
    "verify": "dprint check && biome lint . && tsc -p . && bun test --timeout 60000 ./internal ./packages"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.2",
    "dprint": "0.61.1",
    "typescript": "5.9.3"
  }
}
