{
  "name": "@probitas-test/reporter",
  "version": "0.7.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/probitas-test/probitas-packages.git",
    "directory": "packages/probitas-reporter"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./mod.ts",
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "files": [
    "dist",
    "**/*.ts",
    "!dist/**/*.ts.map",
    "!**/*_test.ts",
    "!**/_testutils.ts",
    "!**/testkit.ts",
    "!node_modules",
    "_vendor/**/LICENSE",
    "_vendor/**/README.md"
  ],
  "dependencies": {
    "@logtape/logtape": "^1.3.11",
    "@probitas-test/core": "workspace:*",
    "@probitas-test/expect": "workspace:*",
    "@probitas-test/runner": "workspace:*"
  },
  "devDependencies": {
    "@probitas-test/internal-testing": "workspace:*",
    "@std/streams": "npm:@jsr/std__streams@^1",
    "@std/testing": "npm:@jsr/std__testing@^1"
  },
  "publishConfig": {
    "access": "public"
  }
}
